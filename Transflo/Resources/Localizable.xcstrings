          "stringUnit": {
            "state": "translated",
            "value": "ملفاتك أقرب بإيماءة واحدة. تعرّف سريعًا على طريقة الاستخدام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files, one gesture away. Take a quick tour to get started."
