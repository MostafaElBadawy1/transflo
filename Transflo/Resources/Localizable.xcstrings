    "onboarding.toolsDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ملفاتك واقتصّها وغيّر حجمها وحسّنها. تعرض العجلة الأدوات المناسبة للملفات التي تسحبها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compress, crop, resize and polish your files. The wheel offers tools for the files you drag."
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.welcome": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بك في Transflo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Transflo"
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.welcomeHint": {
      "localizations": {
