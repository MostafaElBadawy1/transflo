    "folder.access.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transflo saves results next to your files. Allow it to use this folder, once, so it can save here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ Transflo النتائج بجوار ملفاتك. اسمح له باستخدام هذا المجلد مرة واحدة ليتمكّن من الحفظ فيه."
          }
        }
      }
    },
