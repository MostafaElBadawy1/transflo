          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ النتائج بجانب الملفات الأصلية. إذا طلب macOS إذن الوصول، اسمح بالوصول إلى المجلد الذي تستخدمه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results are saved beside the originals. If macOS asks for folder access, allow the folder you’re using."
          }
        }
      },
      "extractionState": "manual"
    },
    "onboarding.progress": {
      "localizations": {
