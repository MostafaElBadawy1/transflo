    "compression.lightHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you choose Compress on the wheel. Keeps more detail, with a modest reduction in file size."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عند اختيار «ضغط» من العجلة. يحافظ على تفاصيل أكثر مع تقليل بسيط لحجم الملف."
          }
        }
      }
    },
    "compression.mediumHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you choose Compress on the wheel. Balances quality and file size; recommended for everyday use."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عند اختيار «ضغط» من العجلة. يوازن بين الجودة وحجم الملف، ويُنصح به للاستخدام اليومي."
          }
        }
      }
    },
    "compression.strongHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you choose Compress on the wheel. Makes smaller files with a greater loss of detail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عند اختيار «ضغط» من العجلة. ينتج ملفات أصغر مع فقدان أكبر للتفاصيل."
          }
        }
      }
    },
