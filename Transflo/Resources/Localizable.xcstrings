    "settings.wheelHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untick what you don't use. Fewer choices make each petal bigger and easier to hit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تحديد ما لا تستخدمه. الخيارات الأقل تجعل كل بتلة أكبر وأسهل في الإصابة."
          }
        }
      }
    },
    "settings.wheelConvertHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untick formats you never need. A hidden format is hidden for every kind of file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تحديد الصيغ التي لا تحتاجها. الصيغة المخفية تُخفى لكل أنواع الملفات."
